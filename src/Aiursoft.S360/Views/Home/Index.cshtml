@model Aiursoft.S360.Models.HomeViewModels.IndexViewModel
@using Aiursoft.S360.Models.Shared

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/styles/marketing.css" />
    <link rel="stylesheet" href="~/styles/s360.css" />
}

<vc:marketing-navbar></vc:marketing-navbar>

<main class="s360-home">
    <section class="s360-hero">
        <div class="container s360-hero-grid">
            <div class="s360-hero-copy">
                <span class="s360-eyebrow"><span class="s360-pulse"></span> @Localizer["Software supply chain, in focus"]</span>
                <h1>@Localizer["Know every dependency."] <span>@Localizer["Trust every decision."]</span></h1>
                <p class="s360-lead">@Localizer["S360 gives your team one place to request NuGet and npm packages, review their complete dependency trees, and track which exact package files are allowed."]</p>
                <div class="s360-hero-actions">
                    <a asp-controller="SupplyChain" asp-action="Index" class="btn btn-primary btn-lg">
                        @Localizer["Open your workspace"] <i data-lucide="arrow-up-right"></i>
                    </a>
                    <a href="#how-it-works" class="btn btn-outline-light btn-lg">
                        @Localizer["See how it works"] <i data-lucide="arrow-down"></i>
                    </a>
                </div>
                <div class="s360-hero-footnote">
                    <span><i data-lucide="package-check"></i> @Localizer["NuGet and npm"]</span>
                    <span><i data-lucide="fingerprint"></i> @Localizer["Exact SHA-256 evidence"]</span>
                    <span><i data-lucide="shield-alert"></i> @Localizer["Blocklist first"]</span>
                </div>
            </div>
            <div class="s360-console" aria-label="@Localizer["Illustration of a dependency review"]">
                <div class="s360-console-top"><span class="s360-console-mark"></span> S360 <span class="s360-console-top-right">@Localizer["Dependency review"]</span></div>
                <div class="s360-console-body">
                    <div class="s360-console-label">@Localizer["One request, the whole graph"]</div>
                    <div class="s360-graph-node s360-graph-root">
                        <span class="s360-node-icon"><i data-lucide="box"></i></span>
                        <span><strong>example-app</strong><small>@Localizer["Direct request"]</small></span>
                        <span class="s360-mini-pill">npm</span>
                    </div>
                    <div class="s360-graph-branch">
                        <div class="s360-graph-node"><span class="s360-node-icon blue"><i data-lucide="package"></i></span><span><strong>package-a</strong><small>@Localizer["Reviewed artifact"]</small></span><i data-lucide="check" class="s360-node-ok"></i></div>
                        <div class="s360-graph-node"><span class="s360-node-icon violet"><i data-lucide="git-branch"></i></span><span><strong>package-b</strong><small>@Localizer["Transitive dependency"]</small></span><span class="s360-mini-pill amber">@Localizer["Needs review"]</span></div>
                    </div>
                    <div class="s360-console-result"><i data-lucide="shield-check"></i><span>@Localizer["A decision covers the complete resolved graph, not only the package you typed."]</span></div>
                </div>
            </div>
        </div>
    </section>

    <section class="s360-proof-bar">
        <div class="container">
            <span>@Localizer["One coherent workflow"]</span>
            <strong>@Localizer["Request"]</strong><i data-lucide="arrow-right"></i>
            <strong>@Localizer["Resolve"]</strong><i data-lucide="arrow-right"></i>
            <strong>@Localizer["Review"]</strong><i data-lucide="arrow-right"></i>
            <strong>@Localizer["Audit"]</strong>
        </div>
    </section>

    <section id="capabilities" class="s360-section">
        <div class="container">
            <div class="s360-section-heading">
                <span class="s360-kicker">@Localizer["Built for clear decisions"]</span>
                <h2>@Localizer["From package request to policy evidence."]</h2>
                <p>@Localizer["S360 connects the people approving dependencies with the exact packages, versions, sources, and risks behind each decision."]</p>
            </div>
            <div class="s360-feature-grid">
                <article class="s360-feature"><span class="s360-feature-icon"><i data-lucide="network"></i></span><h3>@Localizer["The entire dependency graph"]</h3><p>@Localizer["Submit direct dependencies once. S360 resolves transitive packages and records how each one enters the request."]</p></article>
                <article class="s360-feature"><span class="s360-feature-icon"><i data-lucide="fingerprint"></i></span><h3>@Localizer["Exact artifact evidence"]</h3><p>@Localizer["Record the package source and SHA-256 of each NuGet archive or npm tarball, not just a familiar package name."]</p></article>
                <article class="s360-feature"><span class="s360-feature-icon"><i data-lucide="clipboard-check"></i></span><h3>@Localizer["Human review at the right scale"]</h3><p>@Localizer["Approve a report-backed batch while retaining the individual package decisions and their review history."]</p></article>
                <article class="s360-feature"><span class="s360-feature-icon"><i data-lucide="shield-ban"></i></span><h3>@Localizer["An absolute blocklist"]</h3><p>@Localizer["A blocked package stays blocked even when it appears only as a transitive dependency or matches a broader trust rule."]</p></article>
                <article class="s360-feature"><span class="s360-feature-icon"><i data-lucide="scan-search"></i></span><h3>@Localizer["Ongoing vulnerability visibility"]</h3><p>@Localizer["See known advisories for used versions and for vulnerable versions still permitted by a wildcard rule."]</p></article>
                <article class="s360-feature"><span class="s360-feature-icon"><i data-lucide="library-big"></i></span><h3>@Localizer["A searchable allowed catalog"]</h3><p>@Localizer["Employees can discover current approvals, suppliers, and matching rules before starting another request."]</p></article>
            </div>
        </div>
    </section>

    <section id="how-it-works" class="s360-section s360-section-tint">
        <div class="container">
            <div class="s360-section-heading">
                <span class="s360-kicker">@Localizer["A practical workflow"]</span>
                <h2>@Localizer["Less guesswork for employees. More context for reviewers."]</h2>
            </div>
            <div class="s360-home-learning-layout">
                <div class="s360-step-grid">
                    <article><span>01</span><h3>@Localizer["Request in the browser"]</h3><p>@Localizer["Choose NuGet or npm, list the direct packages, and explain the intended use. No separate request command is needed."]</p></article>
                    <article><span>02</span><h3>@Localizer["Resolve and inspect"]</h3><p>@Localizer["The background resolver records exact versions, package archives, hashes, source, and introduction paths."]</p></article>
                    <article><span>03</span><h3>@Localizer["Review with guardrails"]</h3><p>@Localizer["Reviewers see what is already trusted and what is new. Blacklist and vulnerability checks cannot be hidden by a root approval."]</p></article>
                    <article><span>04</span><h3>@Localizer["Keep watch"]</h3><p>@Localizer["Expiry, revocation, and newly published advisories remain visible after the original approval."]</p></article>
                </div>
                @await Html.PartialAsync("_ConceptGuide", new ConceptGuideViewModel(
                    Localizer["The words behind the workflow"].Value,
                    "book-open-text",
                    [
                        new ConceptTerm(Localizer["Direct and transitive"].Value, Localizer["You request the packages you choose; those packages can bring in others. Every package in the resolved graph needs its own decision."].Value),
                        new ConceptTerm(Localizer["Supplier and source"].Value, Localizer["A supplier groups policy rules. A source is the registry that served the archive; a supplier label does not prove who published it."].Value),
                        new ConceptTerm(Localizer["Artifact SHA-256"].Value, Localizer["A fingerprint of the downloaded .nupkg or npm tarball. It is not a hash of the extracted files or finished app."].Value),
                        new ConceptTerm(Localizer["Wildcard rule"].Value, Localizer["A rule can cover matching future versions, but a match alone is not a completed archive or vulnerability check."].Value),
                        new ConceptTerm(Localizer["Security advisory"].Value, Localizer["A published vulnerability notice. Some use CVE identifiers; others use GHSA or another identifier."].Value)
                    ],
                    Localizer["Open a workspace page for explanations specific to each task."].Value))
            </div>
        </div>
    </section>

    <section id="ecosystems" class="s360-section">
        <div class="container s360-ecosystems">
            <div>
                <span class="s360-kicker">@Localizer["Two ecosystems, one policy language"]</span>
                <h2>@Localizer["Made for the dependencies your teams actually use."]</h2>
                <p>@Localizer["NuGet and npm have different version and installation rules. S360 keeps their package identities distinct while presenting one consistent approval experience."]</p>
                <a asp-controller="SupplyChain" asp-action="Index" class="s360-text-link">@Localizer["Explore available dependencies"] <i data-lucide="arrow-up-right"></i></a>
            </div>
            <div class="s360-ecosystem-cards">
                <article><span class="s360-ecosystem-tag">NuGet</span><h3>@Localizer[".NET packages"]</h3><p>@Localizer["Review restored versions and the original .nupkg files behind your applications."]</p><code>Microsoft.* &nbsp; System.*</code></article>
                <article><span class="s360-ecosystem-tag npm">npm</span><h3>@Localizer["JavaScript packages"]</h3><p>@Localizer["See installed transitive packages and the tarball integrity evidence in one report."]</p><code>@@example/* &nbsp; 10.0.*</code></article>
            </div>
        </div>
    </section>

    <section id="rollout" class="s360-section s360-dark-section">
        <div class="container s360-rollout">
            <div>
                <span class="s360-kicker">@Localizer["Built to grow safely"]</span>
                <h2>@Localizer["Start with visibility and review. Tighten the boundary in stages."]</h2>
                <p>@Localizer["S360 is being prepared as the Web approval center. Runner enforcement, authorization-only package mirrors, and fully offline builds are later rollout stages—not guarantees of this deployment."]</p>
            </div>
            <ol class="s360-rollout-list">
                <li><span>01</span><div><strong>@Localizer["Current mirrors"]</strong><small>@Localizer["Existing package access continues."]</small></div></li>
                <li class="current"><span>02</span><div><strong>@Localizer["S360 Web and review"]</strong><small>@Localizer["Requests, policy, audit, and approval."]</small></div></li>
                <li><span>03</span><div><strong>@Localizer["Authorized mirrors"]</strong><small>@Localizer["Only approved package versions are served."]</small></div></li>
                <li><span>04</span><div><strong>@Localizer["Offline builds"]</strong><small>@Localizer["Build inputs prepared before the network is closed."]</small></div></li>
            </ol>
        </div>
    </section>

    <section class="s360-end-cta">
        <div class="container">
            <div><span class="s360-kicker">@Localizer["Your dependency workspace"]</span><h2>@Localizer["Make the next package decision an informed one."]</h2><p>@Localizer["Find what is already allowed, request what is missing, and follow every decision back to its evidence."]</p></div>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light btn-lg">@Localizer["Go to dashboard"] <i data-lucide="arrow-up-right"></i></a>
        </div>
    </section>
</main>

<vc:marketing-footer></vc:marketing-footer>
