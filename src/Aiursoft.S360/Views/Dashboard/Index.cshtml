@using Aiursoft.S360.Entities
@using Aiursoft.S360.Models.SupplyChainViewModels
@using System.Globalization
@model Aiursoft.S360.Models.DashboardViewModels.IndexViewModel
@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/styles/s360.css" />
}
<div class="container-fluid p-0 s360-overview">
    <header class="s360-overview-heading">
        <div><h1 class="h3">@Localizer["Company overview"]</h1><p class="text-muted mb-0">@Localizer["Projects, dependencies, and the risks that need attention."]</p></div>
        <div class="d-flex gap-2 flex-wrap">
            @if (Model.CanReadSupplyChain)
            {
                <a class="btn btn-outline-primary" asp-controller="SupplyChain" asp-action="Index">@Localizer["Explore compliance"]</a>
            }
            @if (Model.CanSubmitRequests)
            {
                <a class="btn btn-primary" asp-controller="DependencyRequests" asp-action="Create">@Localizer["Request a new dependency"]</a>
            }
        </div>
    </header>
    @if (Model.Summary is { } summary)
    {
        <div class="row g-3 mb-3">
            <div class="col-6 col-xl-3"><a class="card s360-overview-metric" asp-controller="SupplyChain" asp-action="Index" asp-route-tab="projects"><div class="card-body"><span>@Localizer["Reported projects"]</span><strong>@summary.ProjectCount</strong><small>@Localizer["Latest baseline per project"]</small></div></a></div>
            <div class="col-6 col-xl-3"><a class="card s360-overview-metric" asp-controller="SupplyChain" asp-action="Index" asp-route-tab="dependencies"><div class="card-body"><span>@Localizer["Packages in use"]</span><strong>@summary.PackageCount</strong><small>@Localizer["Across reported projects"]</small></div></a></div>
            <div class="col-6 col-xl-3"><a class="card s360-overview-metric" asp-controller="SupplyChain" asp-action="Index" asp-route-tab="dependencies" asp-route-filter="cve"><div class="card-body"><span>@Localizer["Packages with known vulnerabilities"]</span><strong class="@(summary.VulnerablePackageCount > 0 ? "text-danger" : "")">@summary.VulnerablePackageCount</strong><small>@string.Format(@Localizer["{0} affected projects"].Value, summary.VulnerableProjectCount)</small></div></a></div>
            <div class="col-6 col-xl-3"><div class="card s360-overview-metric"><div class="card-body"><span>@Localizer["Awaiting review"]</span><strong>@Model.PendingReviews</strong>
                @if (Model.CanReviewRequests) { <a asp-controller="DependencyReviews" asp-action="Index">@Localizer["Open approval center"]</a> }
                else { <small>@Localizer["Across the organization"]</small> }
            </div></div></div>
        </div>
        <p class="small text-muted">@Localizer["Current baseline reports only; review checks and projects that have not reported are not included. This is not a live production inventory."] @Localizer["Packages are counted by ecosystem, name, and source; versions are grouped."]</p>
        @if (summary.ProjectCount == 0)
        {
            <div class="alert alert-info" role="status"><div class="alert-message">@Localizer["No baseline reports yet. Run a baseline check from a project's official pipeline to populate this overview."]</div></div>
        }
        <div class="row g-3 mb-3">
            @foreach (var chart in new[] {
                (Tab: "projects", Title: @Localizer["Project compliance"].Value, Counts: summary.ProjectStatuses, Total: summary.ProjectCount),
                (Tab: "dependencies", Title: @Localizer["Package compliance"].Value, Counts: summary.PackageStatuses, Total: summary.PackageCount) })
            {
                var segments = new[] {
                    (Status: InventoryStatus.Compliant, Filter: "compliant", Css: "compliant", Label: @Localizer["Compliant"].Value),
                    (Status: InventoryStatus.NonCompliant, Filter: "issues", Css: "issues", Label: @Localizer["Needs attention"].Value),
                    (Status: InventoryStatus.Pending, Filter: "pending", Css: "pending", Label: @Localizer["Not verified"].Value) };
                <div class="col-12 col-lg-6"><section class="card h-100">
                    <div class="card-header"><h2 class="h5 card-title mb-0">@chart.Title</h2></div>
                    <div class="card-body">
                        @if (chart.Total == 0) { <p class="text-muted">@Localizer["No baseline data"]</p> }
                        else
                        {
                            <div class="s360-compliance-chart" aria-label="@chart.Title">
                                @foreach (var segment in segments)
                                {
                                    var count = chart.Counts.GetValueOrDefault(segment.Status);
                                    if (count == 0) { continue; }
                                    var width = (100m * count / chart.Total).ToString("0.####", CultureInfo.InvariantCulture);
                                    <a class="@segment.Css" style="width: @(width)%" asp-controller="SupplyChain" asp-action="Index" asp-route-tab="@chart.Tab" asp-route-filter="@segment.Filter" aria-label="@segment.Label: @count" title="@segment.Label: @count"></a>
                                }
                            </div>
                        }
                        <ul class="s360-chart-legend">
                            @foreach (var segment in segments)
                            {
                                <li><a asp-controller="SupplyChain" asp-action="Index" asp-route-tab="@chart.Tab" asp-route-filter="@segment.Filter"><span><i class="@segment.Css" aria-hidden="true"></i>@segment.Label</span><strong>@chart.Counts.GetValueOrDefault(segment.Status)</strong></a></li>
                            }
                        </ul>
                    </div>
                </section></div>
            }
        </div>
        <p class="small text-muted">@Localizer["Compliant means current checks passed for the reported ecosystems. Not verified includes incomplete reports and missing or stale evidence."]</p>
        <div class="row g-3 mb-3">
            <div class="col-12 col-xl-6"><section class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center gap-2"><h2 class="h5 card-title mb-0">@Localizer["Priority packages"]</h2><a asp-controller="SupplyChain" asp-action="Index" asp-route-tab="dependencies">@Localizer["View all"]</a></div>
                <div class="card-body">
                    <p class="small text-muted">@Localizer["Known vulnerabilities first, then other audit issues. Open a package to see who uses it and the recorded reasons."]</p>
                    @if (summary.PriorityPackages.Count == 0) { <p class="text-muted">@Localizer["No package issues found in the available baseline data."]</p> }
                    @foreach (var package in summary.PriorityPackages)
                    {
                        var affectedProjects = package.AffectedProjectCount;
                        var width = (100m * affectedProjects / Math.Max(1, summary.ProjectCount)).ToString("0.####", CultureInfo.InvariantCulture);
                        <a class="s360-risk-row" asp-controller="SupplyChain" asp-action="Index" asp-route-tab="dependencies" asp-route-ecosystem="@package.Ecosystem" asp-route-query="@package.Name">
                            <span class="s360-risk-title"><strong>@package.Name</strong>@await Html.PartialAsync("../SupplyChain/_InventoryStatus", package.Status)</span>
                            <small>@string.Format(@Localizer["{0} affected projects"].Value, affectedProjects) · @(package.Ecosystem == "nuget" ? "NuGet" : "npm")
                                @if (package.Versions.Any(v => v.Advisories.Count > 0)) { <span> · @Localizer["Known vulnerabilities"]</span> }
                            </small>
                            <span class="s360-risk-track @(package.Status == InventoryStatus.Pending ? "pending" : "")" aria-hidden="true"><span style="width: @(width)%"></span></span>
                        </a>
                    }
                </div>
            </section></div>
            <div class="col-12 col-xl-6"><section class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center gap-2"><h2 class="h5 card-title mb-0">@Localizer["Projects needing attention"]</h2><a asp-controller="SupplyChain" asp-action="Index" asp-route-tab="projects">@Localizer["View all"]</a></div>
                <div class="card-body">
                    <p class="small text-muted">@Localizer["Open a project to trace the dependency path and inspect the exact versions."]</p>
                    @if (summary.PriorityProjects.Count == 0) { <p class="text-muted">@Localizer["No project issues found in the available baseline data."]</p> }
                    @foreach (var project in summary.PriorityProjects)
                    {
                        <a class="s360-risk-row" asp-controller="SupplyChain" asp-action="Index" asp-route-tab="projects" asp-route-project="@project.Name">
                            <span class="s360-risk-title"><strong>@project.Name</strong>@await Html.PartialAsync("../SupplyChain/_InventoryStatus", project.Status)</span>
                            <small>
                                @if (project.Reports.Count == 0) { @Localizer["No complete baseline report"] }
                                else { @string.Format(@Localizer["{0} package versions needing attention"].Value, project.Versions.Count(v => v.Status != InventoryStatus.Compliant)) }
                                @if (project.Incomplete) { <span> · @Localizer["Incomplete report"]</span> }
                            </small>
                        </a>
                    }
                </div>
            </section></div>
        </div>
        <div class="card mb-3"><div class="card-body s360-overview-freshness">
            <span><strong>@Localizer["Latest baseline report"]</strong> @(summary.LatestReportUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? @Localizer["Not available"].Value)</span>
            <span><strong>@Localizer["Last successful OSV sync"]</strong> @(Model.LastVulnerabilitySyncUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? @Localizer["Not available"].Value)
                @if (!Model.VulnerabilityAuditCurrent) { <span class="badge bg-warning text-dark">@Localizer["Missing or stale"]</span> }
            </span>
        </div></div>
    }
    <details class="card" open="@(!Model.CanReadSupplyChain)">
        <summary class="card-header s360-overview-personal"><strong>@Localizer["My requests"]</strong><span class="text-muted">@string.Format(@Localizer["{0} total · {1} in progress · {2} approved"].Value, Model.MyRequests, Model.MyInProgress, Model.MyApproved)</span></summary>
        <div class="card-body">
            @if (Model.CanSubmitRequests) { <p><a asp-controller="DependencyRequests" asp-action="History">@Localizer["View all"]</a></p> }
            @if (Model.RecentRequests.Count == 0) { <p class="mb-0">@Localizer["No requests yet. Request a new dependency when your project needs a package that is not approved."]</p> }
            @foreach (var request in Model.RecentRequests)
            {
                var requestStatus = request.Status switch
                {
                    ApplicationStatus.Resolving => @Localizer["Resolving"].Value,
                    ApplicationStatus.ReadyForReview => @Localizer["Awaiting review"].Value,
                    ApplicationStatus.Failed => @Localizer["Failed"].Value,
                    ApplicationStatus.Approved => @Localizer["Approved"].Value,
                    ApplicationStatus.Rejected => @Localizer["Rejected"].Value,
                    ApplicationStatus.Withdrawn => @Localizer["Withdrawn"].Value,
                    ApplicationStatus.Revoked => @Localizer["Revoked"].Value,
                    _ => request.Status.ToString()
                };
                <a class="s360-risk-row" asp-controller="DependencyRequests" asp-action="Details" asp-route-id="@request.Id"><span class="s360-risk-title"><strong>@(string.IsNullOrWhiteSpace(request.Project) ? string.Format(@Localizer["Request #{0}"].Value, request.Id) : request.Project)</strong><span>@requestStatus</span></span><small>@request.Ecosystem.ToUpperInvariant() · @string.Format(@Localizer["Request #{0}"].Value, request.Id)</small></a>
            }
        </div>
    </details>
</div>
