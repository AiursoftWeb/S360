@model Aiursoft.S360.Views.Shared.Components.MarketingNavbar.MarketingNavbarViewModel

<nav class="navbar navbar-expand-md navbar-dark bg-dark landing-navbar">
    <div class="container">
        <a class="navbar-brand landing-brand text-white" asp-controller="Home" asp-action="Index">
            <span class="s360-brand-mark" aria-hidden="true">S</span>
            S360
        </a>
        <ul class="navbar-nav ms-auto">
            <li class="nav-item d-none d-md-inline-block"><a class="nav-link text-lg px-lg-3" asp-controller="Home" asp-action="Index" asp-fragment="capabilities">@Localizer["Capabilities"]</a></li>
            <li class="nav-item d-none d-md-inline-block"><a class="nav-link text-lg px-lg-3" asp-controller="Home" asp-action="Index" asp-fragment="how-it-works">@Localizer["Workflow"]</a></li>
            <li class="nav-item d-none d-md-inline-block"><a class="nav-link text-lg px-lg-3" asp-controller="Home" asp-action="Index" asp-fragment="rollout">@Localizer["Rollout"]</a></li>
        </ul>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-pill my-2 my-sm-0 ms-3">
            @Localizer["Open workspace"] <i class="align-middle" data-lucide="arrow-up-right"></i>
        </a>
    </div>
</nav>
