@using Aiursoft.WebTools
@model Aiursoft.S360.Models.SupplyChainViewModels.BuildChecksViewModel
@using Aiursoft.S360.Models.Shared
@using Aiursoft.S360.Services
@* ReSharper disable once Razor.SectionNotResolved *@
@section styles { <link rel="stylesheet" href="~/styles/s360.css" /> }

<div class="s360-workspace">
<div class="s360-workspace-head">
<h1>@Localizer["Build check records"]</h1>
<p class="text-muted">@Localizer["Each row is one API batch. Only a complete run with every batch accepted can pass the CLI check. The recorded result is historical; a current blocklist warning is shown separately."]</p>
</div>
<div class="s360-workspace-layout">
<div class="s360-workspace-main">
<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="project" value="@Model.Project" maxlength="200" class="form-control" placeholder="@Localizer["Project"]" /></div>
    <div class="col-auto"><button class="btn btn-primary">@Localizer["Search"]</button></div>
</form>
<p>@Model.Total @Localizer["batch records"]</p>
@foreach (var check in Model.Checks)
{
    <div class="card mb-3" id="check-@check.Id">
        <div class="card-header">
            <strong>@check.Project</strong> · <span data-utc-time="@check.CreatedAtUtc.ToHtmlDateTime()"></span> ·
            @if (check.Trusted) { <span class="badge bg-success">@Localizer["Accepted"]</span> }
            else { <span class="badge bg-danger">@Localizer["Rejected"]</span> }
            @if (Model.RunStatuses.TryGetValue(check.RunId, out var runStatus))
            {
                if (!runStatus.Complete) { <span class="badge bg-warning text-dark">@Localizer["Incomplete run"]</span> }
                else if (runStatus.Trusted) { <span class="badge bg-success">@Localizer["Complete run accepted"]</span> }
                else { <span class="badge bg-danger">@Localizer["Complete run rejected"]</span> }
            }
            @if (check.Dependencies.Any(d => Model.CurrentBlockReasons.ContainsKey(d.Id)))
            {
                <span class="badge bg-danger">@Localizer["Currently blocked"]</span>
            }
        </div>
        <div class="card-body">
            <div class="mb-2"><strong>@Localizer["Audit purpose"]:</strong>
                @switch (BuildCheckRun.Purpose(check.ContextJson))
                {
                    case "baseline": <span class="badge bg-primary">@Localizer["Production baseline"]</span> break;
                    case "review": <span>@Localizer["Review only"]</span> break;
                    default: <span>@Localizer["Undeclared purpose"]</span> break;
                }
            </div>
            @if (BuildCheckRun.ReadContext(check.ContextJson)?.IsAnonymous == true)
            {
                <p class="text-muted"><span class="badge bg-secondary">@Localizer["Anonymous review"]</span>
                    @Localizer["The project and pipeline identifiers are supplied by an unauthenticated caller."]</p>
            }
            <div class="mb-2"><strong>@Localizer["Reported source"]:</strong>
                @switch (BuildCheckRun.Kind(check.ContextJson))
                {
                    case CheckKind.DefaultBranch: <span>@Localizer["Default branch"]</span> break;
                    case CheckKind.MergeRequest: <span>@Localizer["Merge request"]</span> break;
                    case CheckKind.Branch: <span>@Localizer["Other branch"]</span> break;
                    case CheckKind.Tag: <span>@Localizer["Tag build"]</span> break;
                    case CheckKind.Local: <span>@Localizer["Local check"]</span> break;
                    default: <span>@Localizer["Unclassified"]</span> break;
                }
                @{ var context = BuildCheckRun.ReadContext(check.ContextJson); }
                @if (context?.Ref != null) { <code class="ms-2">@context.Ref</code> }
                @if (context?.MergeRequest != null) { <span class="ms-2">MR !@context.MergeRequest</span> }
            </div>
            @if (BuildCheckRun.ReadContext(check.ContextJson) is { UserId: not null } identity)
            {
                <p class="text-muted">@Localizer["Authenticated account"]: <code>@identity.UserId</code> · @Localizer["API Key ID"]: <code>@identity.ApiKeyId</code></p>
            }
            <div>@Localizer["Commit"]: <code>@check.Commit</code> · @Localizer["Pipeline"]: <code>@check.Pipeline</code></div>
            <div>@Localizer["Run"]: <code>@check.RunId</code> · @Localizer["Batch"] @(check.BatchIndex + 1)/@check.BatchCount ·
                @Localizer["Scanned projects"]: @check.ScannedProjectCount ·
                @Localizer["Vulnerability data"]: <span data-utc-time="@check.VulnerabilityDataCheckedAtUtc?.ToHtmlDateTime()"></span></div>
            @if (check.Dependencies.Count() == 0)
            {
                <p class="text-muted mt-2 mb-0">@Localizer["No external dependencies were found in the reported supported projects."]</p>
            }
            <div class="table-responsive mt-2"><table class="table table-sm"><thead><tr>
                <th>@Localizer["Status"]</th><th>@Localizer["Package"]</th><th>@Localizer["Version"]</th>
                <th>@Localizer["Source"]</th><th>@Localizer["SHA-256"]</th><th>@Localizer["Reason"]</th>
            </tr></thead><tbody>
            @foreach (var item in check.Dependencies.OrderBy(d => d.Ecosystem).ThenBy(d => d.Name))
            {
                <tr><td>@(item.Trusted ? @Localizer["Accepted"] : @Localizer["Rejected"])</td>
                    <td>@item.Ecosystem: <code>@item.Name</code></td><td>@item.Version</td><td><small>@item.Source</small></td>
                    <td><code title="@item.Sha256">@item.Sha256[..Math.Min(item.Sha256.Length, 16)]</code></td>
                    <td>@item.Reason
                        @if (Model.CurrentBlockReasons.TryGetValue(item.Id, out var blockReason))
                        {
                            <div class="text-danger small"><strong>@Localizer["Currently blocked"]:</strong> @blockReason</div>
                        }
                    </td></tr>
            }
            </tbody></table></div>
        </div>
    </div>
}
@if (Model.Page > 1) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-project="@Model.Project" asp-route-page="@(Model.Page - 1)">@Localizer["Previous"]</a> }
@if (Model.Page * 50 < Model.Total) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-project="@Model.Project" asp-route-page="@(Model.Page + 1)">@Localizer["Next"]</a> }
</div>
@await Html.PartialAsync("_ConceptGuide", new ConceptGuideViewModel(
    @Localizer["Read a check record"].Value,
    "list-checks",
    [
        new ConceptTerm(@Localizer["Audit purpose"].Value, @Localizer["Review returns a policy decision without saving a project report. Baseline declares production use and updates the project inventory only when every batch has arrived, even if the dependencies are rejected. Older records without a purpose never update production usage."].Value),
        new ConceptTerm(@Localizer["Run"].Value, @Localizer["One reported check attempt. Its batches share a run identifier so you can inspect the complete result."].Value),
        new ConceptTerm(@Localizer["Batch"].Value, @Localizer["A bounded portion of the dependency list sent to the API. An accepted batch is not the same as a complete accepted run."].Value),
        new ConceptTerm(@Localizer["Accepted versus enforced"].Value, @Localizer["Accepted means S360 accepted the reported package evidence for this check. It does not mean every batch arrived or that a GitLab Runner was configured to stop the build."].Value),
        new ConceptTerm(@Localizer["Scanned projects"].Value, @Localizer["The number of supported projects the CLI recognized. A zero-dependency check still contacts S360 and records this count."].Value),
        new ConceptTerm(@Localizer["Decision reason"].Value, @Localizer["The policy explanation recorded when that check ran. A current blocklist warning is separate and never rewrites this history."].Value),
        new ConceptTerm(@Localizer["Vulnerability data time"].Value, @Localizer["When the advisory data behind this decision was last checked; a blank value is not a clean bill of health."].Value)
    ],
    @Localizer["These are reported checks; Runner enforcement is a separate rollout step and is not implied by a record here."].Value))
</div>
</div>
