@using Aiursoft.WebTools
@using Aiursoft.S360.Models.SupplyChainViewModels
@model InventoryViewModel
@{
    ViewData["InventoryScope"] = Model.Scope;
    ViewData["InventoryQuery"] = Model.Query;
}
<div class="s360-workspace s360-inventory">
    <header class="s360-inventory-header">
        <div><span class="s360-inventory-eyebrow">S360 · @Localizer["Supply chain"]</span><h1>@Localizer["Compliance explorer"]</h1><p>@Localizer["Find a project or package, inspect its compliance, and trace why it is used."]</p></div>
        <div class="d-flex flex-wrap gap-2"><a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">@Localizer["Company overview"]</a><a class="btn btn-outline-primary" asp-controller="SupplyChain" asp-action="Index" asp-route-tab="rules">@Localizer["Approval rules and tools"]</a></div>
    </header>
    <nav class="s360-inventory-tabs" aria-label="@Localizer["Inventory views"]">
        <a class="@(Model.Tab == "projects" ? "active" : "")" aria-current="@(Model.Tab == "projects" ? "page" : null)" asp-controller="SupplyChain" asp-action="Index" asp-route-tab="projects" asp-route-scope="@Model.Scope" asp-route-ecosystem="@Model.Ecosystem" asp-route-query="@Model.Query" asp-route-filter="@Model.Filter"><i data-lucide="folder-git-2" aria-hidden="true"></i>@Localizer["Projects"]</a>
        <a class="@(Model.Tab == "dependencies" ? "active" : "")" aria-current="@(Model.Tab == "dependencies" ? "page" : null)" asp-controller="SupplyChain" asp-action="Index" asp-route-tab="dependencies" asp-route-scope="@Model.Scope" asp-route-ecosystem="@Model.Ecosystem" asp-route-query="@Model.Query" asp-route-filter="@Model.Filter"><i data-lucide="package" aria-hidden="true"></i>@Localizer["Dependencies"]</a>
    </nav>
    @if (!Model.CanRead)
    {
        <div class="alert alert-info" role="status"><div class="alert-message">@Localizer["Reading project inventory requires supply-chain read permission. You can still browse the approval rules."]</div></div>
    }
    else
    {
        <div class="s360-inventory-overview">
            <div><strong>@Model.PackageCount</strong><span>@Localizer["Observed packages"]</span></div>
            <div><strong>@Model.ProjectCount</strong><span>@Localizer["Projects with reports"]</span></div>
            <div><strong>@Model.ProblemCount</strong><span>@Localizer["Packages needing attention"]</span></div>
            <p>@Localizer["Counts describe the selected report scope. Status is evaluated against current policy and stored vulnerability data."]</p>
        </div>
        <form method="get" asp-controller="SupplyChain" asp-action="Index" class="s360-inventory-search">
            <input type="hidden" name="tab" value="@Model.Tab" />
            @if (Model.Project != null) { <input type="hidden" name="project" value="@Model.Project" /> }
            <label class="s360-inventory-query">@Localizer["Search inventory"]<input type="search" name="query" value="@Model.Query" maxlength="214" class="form-control" placeholder="@Localizer["Package, project, purpose or approval reason"]" /></label>
            <label>@Localizer["Reports"]<select name="scope" class="form-select">
                <option value="baseline" selected="@(Model.Scope == "baseline")">@Localizer["Current baseline"]</option>
                <option value="history" selected="@(Model.Scope == "history")">@Localizer["Unclassified history"]</option>
            </select></label>
            <label>@Localizer["Ecosystem"]<select name="ecosystem" class="form-select">
                <option value="all" selected="@(Model.Ecosystem == "all")">@Localizer["NuGet and npm"]</option>
                <option value="nuget" selected="@(Model.Ecosystem == "nuget")">NuGet</option>
                <option value="npm" selected="@(Model.Ecosystem == "npm")">npm</option>
            </select></label>
            <label>@Localizer["Status"]<select name="filter" class="form-select">
                <option value="all" selected="@(Model.Filter == "all")">@Localizer["All statuses"]</option>
                <option value="issues" selected="@(Model.Filter == "issues")">@Localizer["Needs attention"]</option>
                <option value="cve" selected="@(Model.Filter == "cve")">@Localizer["Known vulnerabilities"]</option>
                <option value="pending" selected="@(Model.Filter == "pending")">@Localizer["Not verified"]</option>
                <option value="compliant" selected="@(Model.Filter == "compliant")">@Localizer["Compliant"]</option>
            </select></label>
            <button class="btn btn-primary">@Localizer["Search"]</button>
        </form>
        <div class="s360-inventory-context">
            @if (Model.Scope == "baseline") { <span>@Localizer["Latest complete baselines. These are reported dependencies, not proof of deployment."]</span> }
            else if (Model.Scope == "review") { <span>@Localizer["Review checks are not saved as project inventory."]</span> }
            else { <span>@Localizer["Older reports without a declared purpose. Current use cannot be inferred from these records."]</span> }
            <a asp-controller="SupplyChain" asp-action="Index" asp-route-tab="@Model.Tab">@Localizer["Reset filters"]</a>
        </div>
        @if (Model.Project != null) { <h2 class="h4 mb-3">@Model.Project</h2> }
        <div class="s360-inventory-results" role="status">@string.Format(@Localizer["{0} results · Page {1} of {2}"].Value, Model.Total, Model.Page, Model.PageCount)</div>
        @if (Model.Total == 0)
        {
            <div class="s360-inventory-empty"><i data-lucide="search" aria-hidden="true"></i><h2>@Localizer["No matching records"]</h2><p>@Localizer["Try a different search or report scope. An approval rule alone is not evidence that a project uses a package."]</p><a asp-controller="SupplyChain" asp-action="Index" asp-route-tab="rules">@Localizer["Browse approval rules"]</a></div>
        }
        @if (Model.Tab == "dependencies")
        {
            <div class="s360-inventory-package-list">
                @foreach (var package in Model.Packages) { @await Html.PartialAsync("../SupplyChain/_InventoryPackage", package) }
            </div>
        }
        else
        {
            <div class="s360-inventory-project-list @(Model.Project == null ? "s360-project-grid" : "")">
            @foreach (var project in Model.Projects)
            {
                @if (Model.Project == null)
                {
                    <a class="s360-project-card" asp-controller="SupplyChain" asp-action="Index" asp-route-tab="projects" asp-route-project="@project.Name" asp-route-scope="@Model.Scope" asp-route-ecosystem="@Model.Ecosystem">
                        <div class="s360-project-card-heading"><i data-lucide="folder-git-2" aria-hidden="true"></i>@await Html.PartialAsync("../SupplyChain/_InventoryStatus", project.Status)</div>
                        <h2>@project.Name</h2>
                        <small>@Localizer["Status covers only the reported ecosystems."]
                            @if (!project.Reports.Any(r => r.Ecosystem == "nuget")) { <span>@Localizer["NuGet: not included in this audit."]</span> }
                            @if (!project.Reports.Any(r => r.Ecosystem == "npm")) { <span>@Localizer["npm: not included in this audit."]</span> }
                        </small>
                        <div class="s360-project-card-counts"><span>NuGet <strong>@project.Versions.Count(v => v.Dependency.Ecosystem == "nuget")</strong></span><span>npm <strong>@project.Versions.Count(v => v.Dependency.Ecosystem == "npm")</strong></span></div>
                        <p>@string.Format(@Localizer["{0} vulnerable packages · {1} other packages needing attention"].Value, project.Versions.Count(v => v.Advisories.Count > 0), project.Versions.Count(v => v.Advisories.Count == 0 && v.Status != InventoryStatus.Compliant))</p>
                        @if (project.Reports.Any(r => !r.HasGraph)) { <small>@Localizer["Update the CLI report to see dependency relationships."]</small> }
                        @if (project.Incomplete)
                        {
                            @if (project.Reports.Count == 0) { <small>@Localizer["This report is incomplete. No complete snapshot is available; current coverage is not verified."]</small> }
                            else { <small>@Localizer["A newer report is incomplete."]</small> }
                        }
                        <footer><span>@if (project.Reports.Count > 0) { <span data-utc-time="@(project.Reports.Max(r => r.CheckedAtUtc).ToHtmlDateTime())"></span> }
                            else { @Localizer["No complete report available."] }</span><span>@Localizer["Explore"] →</span></footer>
                    </a>
                    continue;
                }
                <details class="s360-inventory-project" open>
                    <summary><span><strong>@project.Name</strong><small>@string.Format(@Localizer["{0} package artifacts · {1} need attention"].Value, project.Versions.Count, project.Versions.Count(v => v.Status == InventoryStatus.NonCompliant))</small>
                        <small>@Localizer["Status covers only the reported ecosystems."]
                            @if (!project.Reports.Any(r => r.Ecosystem == "nuget")) { <span>@Localizer["NuGet: not included in this audit."]</span> }
                            @if (!project.Reports.Any(r => r.Ecosystem == "npm")) { <span>@Localizer["npm: not included in this audit."]</span> }
                        </small></span>@await Html.PartialAsync("../SupplyChain/_InventoryStatus", project.Status)<i data-lucide="chevron-down" aria-hidden="true"></i></summary>
                    <div class="s360-inventory-project-body"><a class="s360-project-back" asp-controller="SupplyChain" asp-action="Index" asp-route-tab="projects" asp-route-scope="@Model.Scope" asp-route-ecosystem="@Model.Ecosystem">← @Localizer["All projects"]</a>
                        @if (project.Incomplete)
                        {
                            <div class="alert alert-warning" role="status"><div class="alert-message">
                                @if (project.Reports.Count == 0) { @Localizer["This report is incomplete. No complete snapshot is available; current coverage is not verified."] }
                                else { @Localizer["A newer report is incomplete. The last complete snapshot is shown; current coverage is not verified."] }
                            </div></div>
                        }
                        @if (project.Graphs.Count > 0)
                        {
                            @await Html.PartialAsync("../SupplyChain/_InventoryGraph", project.Graphs)
                        }
                        @foreach (var ecosystem in new[] { "nuget", "npm" })
                        {
                            if (Model.Ecosystem != "all" && Model.Ecosystem != ecosystem) { continue; }
                            var reports = project.Reports.Where(r => r.Ecosystem == ecosystem).ToList();
                            var versions = project.Versions.Where(v => v.Dependency.Ecosystem == ecosystem).ToList();
                            var packages = versions.GroupBy(v => (v.Dependency.Name, v.Dependency.Source))
                                .Select(g => new InventoryPackage { Name = g.Key.Name, Source = g.Key.Source, Ecosystem = ecosystem, Versions = g.ToList() })
                                .OrderByDescending(p => p.Versions.Any(v => v.Advisories.Count > 0))
                                .ThenByDescending(p => p.Status).ThenBy(p => p.Name).ThenBy(p => p.Source).ToList();
                            <section class="s360-inventory-ecosystem">
                                <h3>@(ecosystem == "nuget" ? "NuGet" : "npm") <small>@versions.Count</small></h3>
                                @if (reports.Count == 0) { <p class="text-muted">@Localizer["No complete report for this ecosystem. Its compliance is unknown."]</p> }
                                @foreach (var report in reports)
                                {
                                    <p class="small text-muted"><span data-utc-time="@report.CheckedAtUtc.ToHtmlDateTime()"></span> · <a asp-controller="BuildChecks" asp-action="Index" asp-route-checkId="@report.CheckId">@Localizer["Check record"]</a> <code>@report.Commit</code> @if (!string.IsNullOrEmpty(report.Pipeline)) { <span> · @Localizer["Pipeline"] @report.Pipeline</span> }</p>
                                }
                                @if (reports.Any(r => !r.HasGraph))
                                {
                                    <p class="text-muted small">@Localizer["Dependency relationships were not recorded in this report. Run the latest CLI to populate the graph; the package list remains available."]</p>
                                }
                                @if (reports.Count > 0 && versions.Count == 0) { <p>@Localizer["The complete report contains no dependencies for this ecosystem."]</p> }
                                @foreach (var package in packages.Take(100))
                                {
                                    @await Html.PartialAsync("../SupplyChain/_InventoryPackage", package)
                                }
                                @if (packages.Count > 100)
                                {
                                    <a asp-controller="SupplyChain" asp-action="Index" asp-route-tab="dependencies" asp-route-scope="@Model.Scope" asp-route-project="@project.Name" asp-route-ecosystem="@ecosystem">@Localizer["Browse all dependencies for this project"]</a>
                                }
                            </section>
                        }
                    </div>
                </details>
            }
            </div>
        }
        @if (Model.PageCount > 1)
        {
            <nav class="s360-inventory-pagination" aria-label="@Localizer["Result pages"]">
                @if (Model.Page > 1) { <a class="btn btn-outline-primary" asp-controller="SupplyChain" asp-action="Index" asp-route-tab="@Model.Tab" asp-route-scope="@Model.Scope" asp-route-query="@Model.Query" asp-route-project="@Model.Project" asp-route-ecosystem="@Model.Ecosystem" asp-route-filter="@Model.Filter" asp-route-page="@(Model.Page - 1)">@Localizer["Previous"]</a> }
                <span>@string.Format(@Localizer["Page {0} of {1}"].Value, Model.Page, Model.PageCount)</span>
                @if (Model.Page < Model.PageCount) { <a class="btn btn-outline-primary" asp-controller="SupplyChain" asp-action="Index" asp-route-tab="@Model.Tab" asp-route-scope="@Model.Scope" asp-route-query="@Model.Query" asp-route-project="@Model.Project" asp-route-ecosystem="@Model.Ecosystem" asp-route-filter="@Model.Filter" asp-route-page="@(Model.Page + 1)">@Localizer["Next"]</a> }
            </nav>
        }
    }
</div>
