<details class="s360-status-legend mb-3">
    <summary>@Localizer["What do these statuses mean?"]</summary>
    <div class="s360-state-list mt-3">
        <span class="s360-state s360-state-danger"><i data-lucide="triangle-alert" aria-hidden="true"></i>@Localizer["Production report affected: upgrade the project"]</span>
        <span class="s360-state s360-state-protected"><i data-lucide="shield-check" aria-hidden="true"></i>@Localizer["Admission denied: protects future package supply"]</span>
        <span class="s360-state s360-state-warning"><i data-lucide="file-x" aria-hidden="true"></i>@Localizer["Authorization mismatch: review the version and rules"]</span>
        <span class="s360-state s360-state-warning"><i data-lucide="circle-help" aria-hidden="true"></i>@Localizer["Evidence missing or uncertain: verify the reports and audit"]</span>
    </div>
    <p class="small mt-2 mb-0">@Localizer["These facts can coexist. Approval does not override vulnerability checks, and admission denial does not repair a deployed package. Green means only that this check passed."]</p>
</details>
