<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aiursoft.S360</AssemblyName>
    <RootNamespace>Aiursoft.S360</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.AiurProtocol.Server" Version="10.0.33" />
    <PackageReference Include="Aiursoft.ClickhouseLoggerProvider" Version="10.0.26" />
    <PackageReference Include="Aiursoft.DbTools.Switchable" Version="10.0.26" />
    <PackageReference Include="Aiursoft.Scanner" Version="10.0.13" />
    <PackageReference Include="Aiursoft.UiStack" Version="10.0.26" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.Canon.ScheduledTasks" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aiursoft.S360.InMemory\Aiursoft.S360.InMemory.csproj" />
    <ProjectReference Include="..\Aiursoft.S360.SDK\Aiursoft.S360.SDK.csproj" />
    <ProjectReference Include="..\Aiursoft.S360.MySql\Aiursoft.S360.MySql.csproj" />
    <ProjectReference Include="..\Aiursoft.S360.Sqlite\Aiursoft.S360.Sqlite.csproj" />
  </ItemGroup>
</Project>
