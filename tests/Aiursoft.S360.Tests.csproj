    <None Include="../src/Aiursoft.S360/wwwroot/js/project-badge.js" TargetPath="wwwroot/js/project-badge.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../src/Aiursoft.S360/wwwroot/js/dependency-graph.js" TargetPath="wwwroot/js/dependency-graph.js" CopyToOutputDirectory="PreserveNewest" />
